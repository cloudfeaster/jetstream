# Written by `jetstream sync` (website pack); don't edit.
#
# npm install and npm update take no version released in the last 7 days,
# as uv's exclude-newer does for Python packages and Dependabot's cooldown
# for its updates. npm ci installs what package-lock.json says, whatever its
# age. A dependency is saved at its exact version.
min-release-age=7
save-exact=true
